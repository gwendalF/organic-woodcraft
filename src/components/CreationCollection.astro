---
type Photo = {src:string;thumb:string;width:number;height:number;title:string};
type Props = {title:string;intro:string;photos:Photo[];galleryUrl:string;galleryLabel:string};
const {title,intro,photos,galleryUrl,galleryLabel} = Astro.props;
---
<section class="collection">
  <p class="eyebrow">DE LA FORÊT AU MEUBLE</p><h1>{title}</h1><p class="intro">{intro}</p>
  <div class="creations">{photos.map(photo => <a href={galleryUrl} aria-label={`Voir dans le showroom : ${photo.title}`}><img src={photo.thumb} alt={photo.title} width={photo.width} height={photo.height} loading="lazy" decoding="async"/><h2>{photo.title}</h2></a>)}</div>
  <p class="note">Chaque pièce possède son veinage et son histoire. Les photos présentent des réalisations de l’atelier ; les disponibilités et les détails se précisent selon votre projet.</p>
  <a class="gallery-link" href={galleryUrl}>{galleryLabel} →</a>
</section>
<style>
  .collection{max-width:1160px;margin:auto;padding:60px 24px;color:#f5f2e8}.eyebrow{letter-spacing:.2em;font-size:12px;color:#d7b965}h1{font:clamp(38px,6vw,68px)/1.15 Georgia,serif;margin:18px 0 24px}.intro{font-size:19px;max-width:780px;line-height:1.8;color:#c9d6cf}.creations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin:36px 0}.creations a{border:1px solid #d7b96544;border-radius:12px;overflow:hidden;background:#143d30}.creations img{width:100%;height:250px;object-fit:cover}.creations h2{font-size:16px;padding:18px;line-height:1.5}.creations a:hover h2{color:#e4c671}.creations a:focus-visible,.gallery-link:focus-visible{outline:3px solid #e4c671;outline-offset:4px}.note{max-width:760px;color:#c9d6cf;line-height:1.8;margin:24px 0}.gallery-link{display:inline-block;color:#e4c671;text-decoration:underline;text-underline-offset:5px;padding:12px 0}@media(max-width:850px){.creations{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){.collection{padding:36px 16px}.creations{grid-template-columns:1fr}.creations img{height:280px}}
</style>
