---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import photos from '../data/showroom.json';
const categories = [ ['tout','Tout découvrir'], ['terminees','Réalisations terminées'], ['en-cours','Créations en cours'], ['exterieur','Extérieur, abattage et grumes'], ['atelier','L’atelier'], ['planches','Planches'], ['essences','Essences de bois'], ['sur-mesure','Réalisations sur mesure'] ];
---
<BaseLayout>
<section class="showroom">
  <div class="intro"><p class="eyebrow">DE LA FORÊT AU MEUBLE</p><h1>Le showroom</h1><p>Le bois, le geste et les créations. Entrez dans l’univers d’Organic Woodcraft, de la grume aux dernières finitions.</p></div>
  <nav class="filters" aria-label="Rubriques du showroom">{categories.map(([id,label]) => <button type="button" data-filter={id} aria-pressed={id==='tout'}>{label}</button>)}</nav>
  <div class="gallery-heading"><h2 id="gallery-title">Tout découvrir</h2><p id="photo-count" aria-live="polite">{photos.length} photos</p></div>
  <div id="wood-panel" hidden><h2>La singularité du bois massif</h2><p>Chêne, châtaignier, merisier… Chaque essence possède son veinage et sa personnalité. Le bois est séché naturellement avant d’être transformé à l’atelier.</p><a href="/woods">Découvrir les essences de bois →</a></div>
  <div class="gallery">{photos.map((photo,index)=><button type="button" class="photo" data-categories={photo.categories.join(' ')} data-index={index} aria-label={`Agrandir : ${photo.title}`}><img src={photo.thumb} alt={photo.title} width={photo.width} height={photo.height} loading={index<6?'eager':'lazy'} decoding="async"/><span>{photo.title}<span aria-hidden="true">↗</span></span></button>)}</div>
  <aside class="custom"><p class="eyebrow">UNE ENVIE, UN PROJET ?</p><h2>Une pièce qui vous ressemble</h2><p>Des dimensions adaptées, un bois qui vous plaît, un usage à imaginer ensemble. Parlons de votre prochaine création.</p><a href="/showroom#sur-mesure">Explorer les réalisations sur mesure →</a></aside>
</section>
<dialog id="photo-dialog" aria-label="Photo du showroom"><button type="button" class="close" aria-label="Fermer la photo">×</button><button type="button" class="previous" aria-label="Photo précédente">‹</button><figure><img id="large-photo" alt=""/><figcaption id="photo-caption"></figcaption></figure><button type="button" class="next" aria-label="Photo suivante">›</button></dialog>
<script define:vars={{photos}}>
const cards=[...document.querySelectorAll('.photo')],filters=[...document.querySelectorAll('[data-filter]')];
const dialog=document.querySelector('#photo-dialog'),large=document.querySelector('#large-photo'),caption=document.querySelector('#photo-caption');
let active='tout',current=0,opener=null;
function visible(){return cards.filter(card=>!card.hidden).map(card=>Number(card.dataset.index))}
function filter(id){active=id;filters.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.filter===id)));cards.forEach(c=>c.hidden=id==='essences'||(id!=='tout'&&!c.dataset.categories.split(' ').includes(id)));document.querySelector('#wood-panel').hidden=id!=='essences';document.querySelector('#gallery-title').textContent=filters.find(b=>b.dataset.filter===id).textContent;document.querySelector('#photo-count').textContent=id==='essences'?'':`${visible().length} photos`;history.replaceState(null,'',id==='tout'?location.pathname:`#${id}`)}
filters.forEach(b=>b.addEventListener('click',()=>filter(b.dataset.filter)));
function show(index){current=index;const p=photos[index];large.src=p.src;large.alt=p.title;caption.textContent=`${p.title} · ${visible().indexOf(index)+1} / ${visible().length}`}
cards.forEach(c=>c.addEventListener('click',()=>{opener=c;show(Number(c.dataset.index));dialog.showModal();document.body.style.overflow='hidden'}));
function move(delta){const list=visible();show(list[(list.indexOf(current)+delta+list.length)%list.length])}
dialog.querySelector('.close').addEventListener('click',()=>dialog.close());dialog.querySelector('.previous').addEventListener('click',()=>move(-1));dialog.querySelector('.next').addEventListener('click',()=>move(1));dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});dialog.addEventListener('close',()=>{document.body.style.overflow='';opener?.focus()});dialog.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){e.preventDefault();move(1)}if(e.key==='ArrowLeft'){e.preventDefault();move(-1)}});
function applyHash(){const id=location.hash.slice(1)||'tout';if(filters.some(b=>b.dataset.filter===id))filter(id)}
window.addEventListener('hashchange',applyHash);applyHash();
</script>
<style>
.showroom{max-width:1280px;margin:auto;padding:64px 24px;color:#f5f2e8}.intro{max-width:720px;margin-bottom:36px}.eyebrow{letter-spacing:.2em;color:#d7b965;font-size:12px;font-weight:600}h1{font-family:Georgia,serif;font-size:clamp(42px,7vw,76px);line-height:1.1;margin:16px 0 22px}h2{font-family:Georgia,serif;font-size:28px}.intro>p:last-child{color:#c9d6cf;font-size:19px;line-height:1.7}.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:36px}.filters button{border:1px solid #667b70;border-radius:24px;padding:10px 16px;color:#e4e9df;font-size:14px;cursor:pointer}.filters button[aria-pressed=true]{background:#d7b965;color:#172e26;border-color:#d7b965}.filters button:hover{border-color:#d7b965}.filters button:focus-visible,.photo:focus-visible{outline:3px solid #f7df94;outline-offset:4px}.gallery-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px}.gallery-heading p{color:#c9d6cf;font-size:14px}.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.photo{display:block;text-align:left;background:#163e32;border:1px solid #ffffff18;border-radius:12px;overflow:hidden;cursor:zoom-in}.photo[hidden],#wood-panel[hidden]{display:none}.photo img{width:100%;height:280px;object-fit:cover;transition:transform .3s}.photo:hover img{transform:scale(1.025)}.photo>span{display:flex;justify-content:space-between;padding:14px 16px;font-size:14px}.custom{margin-top:64px;padding:36px;background:#143d30;border:1px solid #d7b96555;border-radius:12px}.custom p:not(.eyebrow),#wood-panel p{color:#c9d6cf;line-height:1.7;max-width:680px;margin:16px 0}.custom a,#wood-panel a{color:#e4c671;text-decoration:underline;text-underline-offset:5px}.custom h2{margin-top:12px}#wood-panel{padding:32px;background:#153f32;border-radius:12px}dialog{position:fixed;inset:0;margin:auto;border:0;background:#0a1712;color:white;width:95vw;max-width:1500px;height:92dvh;padding:50px 64px 24px;border-radius:12px}dialog::backdrop{background:#000d}dialog figure{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px}dialog img{max-width:100%;max-height:calc(100% - 44px);object-fit:contain}dialog figcaption{text-align:center;color:#e5dcc3;font-size:14px}dialog button{position:absolute;font-size:36px;cursor:pointer;background:#183d30;border-radius:8px;padding:0 12px}dialog .close{right:16px;top:8px}dialog .previous{left:8px;top:48%}dialog .next{right:8px;top:48%}@media(max-width:850px){.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.photo img{height:230px}}@media(max-width:540px){.showroom{padding:36px 16px}.gallery{gap:12px}.photo img{height:180px}.photo>span{font-size:12px;padding:10px}.filters{gap:8px}.filters button{font-size:12px;padding:9px 12px}.gallery-heading h2{font-size:23px}dialog{width:100vw;height:100dvh;border-radius:0;padding:52px 38px 20px}.custom{padding:24px}}
</style>
