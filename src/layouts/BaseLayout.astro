---
type Props = {
  mainClass?: string;
  title?: string;
  description?: string;
};

const { mainClass = "", title = "Organic Woodcraft — Créations & sur-mesure", description = "Créations en bois massif et mobilier sur mesure à Saint-Jacut-les-Pins. De la forêt au meuble, avec un bois séché naturellement." }: Props = Astro.props;
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="bg-white text-black flex flex-col min-h-screen">
    <Header />
    <main
      class={`h-full grow ${mainClass} bg-linear-to-b from-teal-900 to-teal-950`}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
